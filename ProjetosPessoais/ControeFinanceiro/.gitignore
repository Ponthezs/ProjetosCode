# ==========================================
# FinanceControl - Git Ignore Rules
# ==========================================

# 1. Arquivos de Dados Financeiros e Planilhas Pessoais
*.csv
*.xlsx
*.xls
*.ods

# Permitir apenas arquivo .gitkeep nas pastas de armazenamento
!dados/.gitkeep
!backups/.gitkeep
!exports/.gitkeep

# Conteúdo das pastas de dados sensíveis
dados/*
backups/*
exports/*

# 2. Banco de Dados SQLite Local
*.db
*.sqlite
*.sqlite3
database/*.db

# 3. Cache do Python & Ambientes Virtuais
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 4. Configurações da IDE e Sistema Operacional
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# 5. Streamlit Cache Local
.streamlit/secrets.toml
