# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here

# Database Configuration
# Use sqlite+aiosqlite:///./data/game_deals.db for SQLite or postgresql+asyncpg://user:pass@host:5432/dbname for PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./data/game_deals.db

# Scheduler Configuration
CHECK_INTERVAL_MINUTES=30

# Deal Settings
MIN_DISCOUNT=50
EXTREME_DISCOUNT=80
PREFERRED_CURRENCY=BRL

# Default Discord Channels (IDs or set per-guild via /setup command)
CHANNEL_FREE_GAMES=
CHANNEL_DEALS=
CHANNEL_BIG_DEALS=
CHANNEL_NEW_OFFERS=
CHANNEL_EXPIRED=

# Web Panel Configuration
WEB_HOST=0.0.0.0
WEB_PORT=8000
SECRET_KEY=supersecretkey_change_me_in_production
